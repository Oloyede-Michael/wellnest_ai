PORT=4100
NODE_ENV=development

# Database type: 'sqlite' (zero-config, default) or 'mysql'
DB_TYPE=sqlite
DB_DATABASE=wellnest.sqlite

# MySQL settings (used when DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=wellnest_ai

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
