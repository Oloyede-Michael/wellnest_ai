PORT=4100
NODE_ENV=development

# Database type: 'sqlite' (zero-config, default), 'postgres', or 'mysql'
DB_TYPE=sqlite
DB_DATABASE=wellnest.sqlite

# Postgres settings (used when DB_TYPE=postgres)
# On Render, easiest is to set DATABASE_URL to the Internal Database URL
# and leave the individual fields below empty.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=wellnest_ai
# Set to false only for local postgres without TLS
DB_SSL=true

# MySQL settings (used when DB_TYPE=mysql)
DB_HOST_MYSQL_NOTE=see DB_HOST/DB_PORT above

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
